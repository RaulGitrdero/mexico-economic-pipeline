*.zip
*.ZIP

# ─── Formatos de datos pesados ───────────────────────────────────────────────
*.parquet
*.orc
*.avro

# ─── Archivos de datos en crudo ──────────────────────────────────────────────
data/**/*.csv
data/**/*.xlsx
data/**/*.xls

